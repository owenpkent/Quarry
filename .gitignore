# Generated by tools/bench/make_corpus.py, deterministically, so it is rebuilt rather than
# committed. Real corpus material dropped in alongside it is ignored here too: audio belongs
# wherever the person running the bench keeps it, not in this repository.
Tests/bench_corpus/

# Generated by tools/bench/fetch_maestro.py + tools/bench/make_real_corpus.py, deterministically,
# from a local MAESTRO/FluidSynth/SoundFont cache: rebuilt on demand, not committed.
Tests/bench_corpus_maestro/

# Generated by tools/bench/make_real_audio_corpus.py, deterministically, from a local
# maestro-v3.0.0.zip: the real-audio twin of Tests/bench_corpus_maestro/ (same names, same
# ground truth, real recordings instead of a FluidSynth render). Rebuilt on demand, not committed.
Tests/bench_corpus_maestro_real/

# Generated by tools/bench/make_slakh_corpus.py, deterministically, from a local BabySlakh
# cache (~/.okstudio/slakh-cache): rebuilt on demand, not committed.
Tests/bench_corpus_slakh/

# Generated by tools/bench/make_gm_corpus.py from the user's own MIDI collection: copyrighted
# arrangements, rebuilt on demand, must never be committed.
Tests/bench_corpus_gm/

# Generated by tools/bench/make_smd_corpus.py, deterministically, from a local Saarland Music
# Data cache (~/.okstudio/smd-cache): rebuilt on demand, not committed.
Tests/bench_corpus_smd/

# Generated by tools/keybench/make_giantsteps_corpus.py from the GiantSteps audio cache
# (~/.okstudio/giantsteps-cache): Beatport preview mp3s, rebuilt on demand, never committed.
Tests/bench_corpus_giantsteps/
tools/bench/.venv/

# The bake-off's own virtualenv and its run output, plus downloaded model checkpoints: all
# reproducible from tools/bakeoff/*.py and a `pip install`, none of it belongs in the repo.
tools/bakeoff/.venv/
tools/bakeoff/out/
tools/bakeoff/*_cache/
tools/bakeoff/checkpoints/

# The key bench's note dumps: reproducible from the commands in BENCH.md §4.
tools/keybench/out/
